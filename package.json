{
  "name": "fluent-comments",
  "version": "2.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run i18n && npm run build:main && npm run build:block",
    "i18n": "node i18n.node.js",
    "build:main": "vite build",
    "build:block": "wp-scripts build resources/block/editor.jsx --output-path=dist/block",
    "dev:block": "wp-scripts start resources/block/editor.jsx --output-path=dist/block"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@wordpress/scripts": "^30.12.0",
    "sass": "^1.83.4",
    "svelte": "^5.19.0",
    "unplugin-auto-import": "^0.18.6",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^6.0.11",
    "vue": "^3.5.13"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.9.6",
    "vue-router": "^4.5.0"
  }
}
